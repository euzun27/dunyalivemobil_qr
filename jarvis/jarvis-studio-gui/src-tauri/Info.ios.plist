<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- DUNYATEK iOS: tauri ios build bu dosyayı oluşturulan Info.plist ile birleştirir. -->
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>DUNYATEK</string>
	<key>NSCameraUsageDescription</key>
	<string>DUNYATEK, görüntü almanız istendiğinde kamerayı kullanır.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>DUNYATEK, sesli komutlarınızı duymak için mikrofonu kullanır.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>DUNYATEK, aynı ağdaki bilgisayarınızdaki asistana bağlanmak için yerel ağı kullanır.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>DUNYATEK, bilgisayar kontrolünü onaylamak için Face ID kullanır.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Bilgisayardaki asistan düz HTTP (8002) ile konuşur: ev ağı ve Tailscale (100.x).
		     NSAllowsLocalNetworking EKLENMEMELİ: varken iOS NSAllowsArbitraryLoads'u yok sayar
		     ve yalnızca yerel ağa izin verir; Tailscale adresi engellenir. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
